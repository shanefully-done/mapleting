<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Configuration Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/configuration"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Nickname Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/nicknameLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/nickname_hint"
            app:boxBackgroundMode="outline"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/nicknameEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Package Name Input (Optional, has default) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/packageNameLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/package_name_hint_optional"
                app:boxBackgroundMode="outline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/packageNameEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/browseAppsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:text="Browse"
                android:minWidth="80dp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- Server URL Input (Advanced, has default) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/serverUrlLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/server_url_hint_optional"
            app:boxBackgroundMode="outline"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/serverUrlEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:maxLines="1"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Advanced Toggle -->
        <CheckBox
            android:id="@+id/advancedCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/show_advanced_settings"
            android:layout_marginBottom="16dp" />

        <!-- Status Display -->
        <TextView
            android:id="@+id/statusTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_stopped"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Start/Stop Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/startStopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_monitoring"
            android:textSize="16sp"
            app:cornerRadius="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Test Detection Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/testDetectionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test App Detection"
            android:textSize="14sp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:cornerRadius="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Battery Optimization Section -->
        <TextView
            android:id="@+id/batteryOptimizationTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/battery_optimization_checking"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/batteryOptimizationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_battery_settings"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:cornerRadius="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Accessibility Permission Section -->
        <TextView
            android:id="@+id/accessibilityPermissionTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/accessibility_permission_checking"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/accessibilityPermissionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_accessibility_settings"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:cornerRadius="8dp"
            android:layout_marginBottom="24dp" />

        <!-- Current Config Display -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/current_config"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/configDisplayTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_config_saved"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="16dp" />

        <!-- Logs Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/logs_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <ScrollView
            android:id="@+id/logsScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/black"
            android:padding="8dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/logsTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_logs_yet"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textColor="@android:color/white"
                android:gravity="start|top" />
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearLogsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clear_logs"
            android:textSize="14sp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:cornerRadius="8dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>