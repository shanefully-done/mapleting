<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.MapletingMonitor" parent="Theme.Material3.DayNight">
        <!-- Primary brand color - Dark gray -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        
        <!-- Secondary brand color - Medium gray -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        
        <!-- Action bar color -->
        <item name="android:actionBarStyle">@style/Widget.MaterialComponents.ActionBar.Solid</item>
        
        <!-- Background colors -->
        <item name="android:windowBackground">@color/white</item>
        <item name="colorOnBackground">@color/gray_900</item>
        
        <!-- Surface colors -->
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/gray_800</item>
        
        <!-- Error colors -->
        <item name="colorError">@color/status_stopped</item>
        <item name="colorOnError">@color/white</item>
    </style>
</resources>