# Environment Variables for Next.js PWA Monitoring & Notification System
# Copy this file to .env.local and fill in your actual values
# .env.local is git-ignored and should never be committed

# ============================================
# SUPABASE DATABASE CONFIGURATION
# ============================================

# Your Supabase project URL (found in Supabase Dashboard > Settings > API)
# Example: https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Supabase anonymous/public key (found in Supabase Dashboard > Settings > API)
# This key is safe to expose in client-side code
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Supabase service role key (found in Supabase Dashboard > Settings > API)
# WARNING: This key bypasses Row Level Security (RLS) - never commit to git
# Use this only for server-side operations (API routes)
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ============================================
# WEB PUSH (VAPID) CONFIGURATION
# ============================================

# Generate VAPID keys using: npx web-push generate-vapid-keys
# These keys are used for Web Push API authentication

# VAPID public key (safe to expose in client-side code)
# Example: BLx3qK...
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key-here"

# VAPID private key (NEVER commit to git, keep secret)
# Example: YOUR_VAPID_PRIVATE_KEY_HERE
VAPID_PRIVATE_KEY="your-vapid-private-key-here"

# VAPID subject (contact email for the push service)
# Must be a valid email address or URL
# Example: mailto:admin@example.com
VAPID_SUBJECT="mailto:admin@example.com"

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Base URL of your application (used for notification clicks and redirects)
# Include protocol (https://) and no trailing slash
# Example: https://your-domain.com
APP_BASE_URL="http://localhost:3000"

# Node environment (development, production, or test)
NODE_ENV="development"

# ============================================
# SETUP INSTRUCTIONS
# ============================================

# 1. Create a Supabase project at https://supabase.com
# 2. Go to Settings > API to get your URL and keys
# 3. Run the SQL schema from lib/schema.sql in Supabase SQL Editor
# 4. Generate VAPID keys: npx web-push generate-vapid-keys
# 5. Copy this file to .env.local and fill in all values
# 6. Run: bun install
# 7. Start development server: bun dev

# ============================================
# IMPORTANT SECURITY NOTES
# ============================================

# - NEVER commit .env.local to version control
# - NEVER share SUPABASE_SERVICE_ROLE_KEY or VAPID_PRIVATE_KEY
# - Only use service role key in server-side code (API routes)
# - Use anon key for client-side operations (RLS will apply)
# - Rotate keys if they are accidentally exposed
# - Enable RLS policies in Supabase for production use